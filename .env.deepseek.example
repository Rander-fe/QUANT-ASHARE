# Copy this file to .env.deepseek, then replace the placeholder locally.
# Never commit or send the real key in chat.
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
CHAT_MODEL=deepseek/deepseek-v4-flash
CHAT_OPENAI_BASE_URL=https://api.deepseek.com
CHAT_STREAM=false
CHAT_TEMPERATURE=0.2
ENABLE_RESPONSE_SCHEMA=true
REASONING_THINK_RM=true
LOG_LLM_CHAT_CONTENT=false

# QUANTMIND/RD-Agent trial constraints
QLIB_FACTOR_HYPOTHESIS2EXPERIMENT=quantmind_integration.rdagent_hook.ValidatedQlibFactorHypothesis2Experiment
QM_TRIAL_FACTOR_COUNT=1
QM_TRIAL_STATUS=experimental
QM_TRIAL_ALLOW_SOTA_WRITE=false
