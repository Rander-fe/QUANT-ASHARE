APP_ENV=production
TZ=Asia/Shanghai
API_PORT=8000
API_WORKERS=1
IMAGE_TAG=latest
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# Generate with: openssl rand -hex 32
QUANT_API_TOKEN=CHANGE_ME

# Absolute host path on Linux, for example /data/qlib/cn_data
QLIB_DATA_HOST_PATH=./data/qlib

# Optional data-provider credential
TUSHARE_TOKEN=

