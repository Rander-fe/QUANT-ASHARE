# 将项目根目录挂载为容器内 /workspace，并把 /workspace 加入 PYTHONPATH。
PYTHONPATH=/workspace:/app/rd-agent
QLIB_FACTOR_HYPOTHESIS2EXPERIMENT=quantmind_integration.rdagent_hook.ValidatedQlibFactorHypothesis2Experiment
# QuantRDLoop（因子与模型联合优化）使用独立的 QLIB_QUANT_ 前缀。
QLIB_QUANT_FACTOR_HYPOTHESIS2EXPERIMENT=quantmind_integration.rdagent_hook.ValidatedQlibFactorHypothesis2Experiment
QLIB_QUANT_ACTION_SELECTION=bandit
QLIB_FACTOR_TRAIN_START=2016-01-01
QLIB_FACTOR_TRAIN_END=2021-12-31
QLIB_FACTOR_VALID_START=2022-01-01
QLIB_FACTOR_VALID_END=2023-04-30
# RD-Agent内部名为test；这里只允许使用项目验证期，绝不指向最终测试期。
QLIB_FACTOR_TEST_START=2023-05-01
QLIB_FACTOR_TEST_END=2025-01-01
QLIB_QUANT_TRAIN_START=2016-01-01
QLIB_QUANT_TRAIN_END=2021-12-31
QLIB_QUANT_VALID_START=2022-01-01
QLIB_QUANT_VALID_END=2023-04-30
# 原生字段名仍叫 test，但这里仅映射项目冻结验证期，不触碰最终测试期。
QLIB_QUANT_TEST_START=2023-05-01
QLIB_QUANT_TEST_END=2025-01-01
QLIB_PROVIDER_URI=/root/.qlib/qlib_data/cn_data
QM_PREFLIGHT_INSTRUMENT=SH600000
QM_PREFLIGHT_START=2020-01-01
QM_PREFLIGHT_END=2020-03-31
QM_PREFLIGHT_OUTPUT=/workspace/reports/qlib_operator_preflight.json
